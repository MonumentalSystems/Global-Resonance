# Data (too large for git, tracked separately)
data/
!data/INDEX.md
!data/data_paths.py

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
frontend/dist/

# Output
# Ignore output/ contents, but keep the directory itself traversable so the
# trained JellyBallNet weights below can be un-ignored. (A `!` rule cannot
# rescue a file inside a fully-ignored directory — git never descends into it.)
backend/output/*
# Exception: the trained JellyBallNet weights (~30 KB) ship with the image so
# /api/jellyball/neural and the cavity-mode panel work on a fresh deploy.
!backend/output/jellyball_net.pt
target/
**/target/
*.png
*.log
*-backup.*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
data/historical/
!data/historical/*.csv
