# Git
.git
.gitignore

# Large local datasets (provided via volume at runtime)
data/

# Python
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/

# Node
frontend/node_modules/
frontend/dist/

# Build/output artifacts. Keep the trained JellyBallNet weights in the build
# context (server.py loads backend/output/jellyball_net.pt at request time);
# everything else here is regenerable local scratch.
backend/output/*
!backend/output/jellyball_net.pt
**/*.png
backend/uvicorn.log
**/*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs (not needed in image)
*.md
backend/*.md
